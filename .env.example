# ==========================================
# Backend API Configuration (FastAPI)
# ==========================================
APP_ENV=production
APP_NAME=emoji-face-challenge-api
HOST=0.0.0.0
PORT=8084

# Allowed frontend origins for CORS (comma-separated)
CORS_ORIGINS=https://emojichallenge.technula.com,https://api.emojichallenge.technula.com

# MongoDB URI (leave blank for local fallback JSON database)
MONGODB_URI=
MONGODB_DATABASE=emoji_face_challenge

# Storage configuration: local (stores in uploads/) or s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Public URLs for photo preview and QR code claim page
PHOTO_BASE_URL=https://api.emojichallenge.technula.com
MOBILE_CLAIM_BASE_URL=https://api.emojichallenge.technula.com

# Expiration times in minutes
PHOTO_EXPIRY_MINUTES=60
QR_TOKEN_EXPIRY_MINUTES=60

# MetaReach SMS DLT Gateway credentials
SMS_API_URL=https://sms.metareach.in/vb/apikey.php
METAREACH_API_KEY=bmV02HoEeC8RQh9B
METAREACH_SENDER_ID=AGPKAC
METAREACH_TEMPLATE_ID=1707177071739047190
SMS_PE_ID=
SMS_TE_ID=1707177071739047190

# Security Secrets
ADMIN_SECRET=dev_admin_secret_key
JWT_SECRET=dev_jwt_secret_key

# ==========================================
# Frontend Build Configuration (Vite React)
# Set before running `npm run build` in apps/event-app
# ==========================================
VITE_API_BASE_URL=https://api.emojichallenge.technula.com
