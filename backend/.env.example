# Application Configuration
APP_ENV=development
APP_NAME=emoji-face-challenge-api
HOST=0.0.0.0
PORT=3001

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# MongoDB Configuration (Leave blank to use local fallback JSON database)
MONGODB_URI=
MONGODB_DATABASE=emoji_face_challenge

# Storage Configuration
# Options: local, s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Base URLs for QR codes and claim links
PHOTO_BASE_URL=http://localhost:3001
MOBILE_CLAIM_BASE_URL=http://localhost:5174

# Photo and Token Expiration (in minutes)
PHOTO_EXPIRY_MINUTES=60
QR_TOKEN_EXPIRY_MINUTES=60

# Security
ADMIN_SECRET=dev_admin_secret_key_change_in_production
JWT_SECRET=dev_jwt_secret_key_change_in_production
