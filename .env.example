# Application Configuration
APP_ENV=production
APP_NAME=emoji-face-challenge-api
HOST=0.0.0.0
PORT=3001

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=https://emojichallenge.technula.com,http://localhost:5173

# MongoDB Configuration (Leave blank to use local fallback JSON database)
MONGODB_URI=
MONGODB_DATABASE=emoji_face_challenge

# Storage Configuration (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Base URLs for QR codes and claim links
PHOTO_BASE_URL=https://emojichallenge.technula.com
MOBILE_CLAIM_BASE_URL=https://emojichallenge.technula.com

# Photo and Token Expiration (in minutes)
PHOTO_EXPIRY_MINUTES=60
QR_TOKEN_EXPIRY_MINUTES=60

# MetaReach SMS API Configuration
SMS_API_URL=https://sms.metareach.in/vb/apikey.php
METAREACH_API_KEY=
METAREACH_SENDER_ID=
METAREACH_TEMPLATE_ID=
SMS_PE_ID=
SMS_TE_ID=

# Security
ADMIN_SECRET=change_this_to_a_secure_admin_secret
JWT_SECRET=change_this_to_a_secure_jwt_secret
